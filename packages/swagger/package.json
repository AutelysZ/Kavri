{
  "name": "@kavri/swagger",
  "version": "0.0.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.js.map",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rolldown -c && dts-bundle-generator -o index.d.ts src/index.ts --no-banner",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kavri/web": "workspace:*",
    "@kavri/schema": "workspace:*"
  },
  "license": "MIT"
}
